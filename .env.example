# ==== Universidad App — plantilla de variables de entorno ====
# Copiar a .env en desarrollo. NUNCA versionar .env real.
# Generar JWT_SECRET con: openssl rand -base64 48

APP_ENV=dev
HTTP_PORT=8080
LOG_LEVEL=info

# PostgreSQL local (docker-compose de desarrollo)
DB_URL=postgres://universidad:universidad_dev@localhost:5434universidad?sslmode=disable

# Auth — OBLIGATORIO, mínimo 32 bytes
JWT_SECRET=cambia-esto-por-openssl-rand-base64-48

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# SMTP para reset de contraseña. En dev: MAIL_MOCK=true imprime los tokens en el log.
MAIL_MOCK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@localhost
